# Telegram MTProto & Bot Credentials
API_ID=12345678
API_HASH=your_api_hash_here
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ

# Public HTTPS URL of your Hugging Face Space (Required for Mini App button)
WEBAPP_URL=https://your-username-your-space.hf.space

# Storage & Access Control
DB_CHANNEL_ID=-1001234567890
OWNER_ID=987654321
ADMIN_IDS=987654321,112233445

# Multi-MongoDB Atlas Failover Pool (Comma-separated URIs — auto-rotates at threshold!)
MONGO_URIS=mongodb+srv://user1:pass1@cluster1.mongodb.net/?retryWrites=true&w=majority,mongodb+srv://user2:pass2@cluster2.mongodb.net/?retryWrites=true&w=majority
# Backward-compatible single URI fallback
MONGO_URI=
DB_NAME=telegram_vault_bot
# Switch to next DB automatically when storage reaches this MB limit (MongoDB Free Tier = 512 MB; default = 460 MB)
DB_MAX_SIZE_MB=460

# Optional Features (Leave blank to disable)
FSUB_CHANNELS=
AUTO_DELETE_SECONDS=600
PROTECT_CONTENT=False
SHORTENER_API=
SHORTENER_DOMAIN=
PORT=7860
